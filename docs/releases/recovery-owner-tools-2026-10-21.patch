+"""Offline numeric comparison library; production variant has no profile runner."""
+import math
+import statistics
+NUMERIC = ('first_seconds', 'total_seconds', 'max_gap_seconds', 'characters')
+FIELDS = set(NUMERIC) | {'ok', 'case', 'profile', 'round', 'session', 'warmup', 'stage_ms', 'clock_stages_ms', 'failure', 'telemetry', 'quality_recorded'}
+
+def validated_rows(rows):
+    for row in rows:
+        if type(row) is not dict or set(row) - FIELDS or type(row.get('ok')) is not bool:
+            raise ValueError('Invalid numeric benchmark row')
+        for key in NUMERIC:
+            if key in row and (type(row[key]) not in (int, float) or not math.isfinite(row[key]) or row[key] < 0):
+                raise ValueError('Invalid numeric measurement')
+    return rows
+
+def percentile(values, fraction):
+    ordered = sorted(values)
+    index = (len(ordered) - 1) * fraction
+    lower = int(index)
+    return ordered[lower] + (ordered[math.ceil(index)] - ordered[lower]) * (index - lower)
+
+def metrics(values):
+    if not values:
+        return None
+    return {'mean': statistics.mean(values), 'median': statistics.median(values), 'p95': percentile(values, 0.95), 'p99': percentile(values, 0.99), 'stddev': statistics.stdev(values) if len(values) > 1 else 0.0, 'min': min(values), 'max': max(values), 'samples': len(values)}
+
+def summarize(rows):
+    measured = [r for r in validated_rows(rows) if not r.get('warmup', False)]
+    successes = [r for r in measured if r['ok']]
+    return {'attempts': len(measured), 'successes': len(successes), 'failures': len(measured) - len(successes), **{key: metrics([r[key] for r in successes if key in r]) for key in NUMERIC}, 'resources': resource_summary(successes), 'quality': 'unreviewed', 'task_success': None, 'scope': 'HTTP first approved text, excludes browser paint and voice; p99 is descriptive'}
+
+def resource_summary(rows):
+    traces = [r['telemetry'] for r in rows if isinstance(r.get('telemetry'), dict)]
+    cpu = [item['host_cpu_percent'] for item in traces if type(item.get('host_cpu_percent')) in (int, float)]
+    gpu = [item['gpu_after'] for item in traces if isinstance(item.get('gpu_after'), dict)]
+    return {'host_cpu_percent': metrics(cpu), 'gpu_boundary': {key: metrics([item[key] for item in gpu]) for key in ('temperature_c', 'power_w', 'clock_mhz', 'utilization_percent')}, 'scope': 'host/boundary only; no CPU temperature or container attribution'}
