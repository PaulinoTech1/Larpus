{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Larpus AEI persona v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "name",
    "description",
    "system_prompt",
    "model",
    "temperature",
    "voice"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "not": {
        "pattern": "-cloud$"
      }
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "voice": {
      "type": [
        "string",
        "null"
      ]
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    }
  }
}
